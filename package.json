{
  "name": "arceus",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @arceus/web",
    "dev:api": "npm run dev --workspace @arceus/api",
    "run:ui": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-ui.ps1",
    "rebuild:run": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/rebuild-and-run.ps1",
    "db:generate": "npm run db:generate --workspace @arceus/db",
    "db:migrate": "npm run db:migrate --workspace @arceus/db",
    "db:push": "npm run db:push --workspace @arceus/db",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:typedoc": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-react": "^6.0.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.4",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0"
  }
}
