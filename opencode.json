    },
    "tester": {
      "description": "Quality specialist that validates apps and services through browser, accessibility, and smoke testing workflows.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/prompts/tester-soul.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow"
        },
        "webfetch": "allow"
