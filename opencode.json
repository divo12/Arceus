{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "azure": {
      "models": {
        "gpt-5.2": {
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low",
            "parallelToolCalls": false
          }
        }
      }
    }
  },
  "agent": {
    "ceo": {
      "description": "Board-facing CEO that refines ideas, proposes strategy, and requests approvals.",
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/ceo-soul.txt}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        },
        "webfetch": "allow"
      }
    },
    "cto": {
      "description": "Technical lead that decomposes strategy into architecture and execution plans.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/prompts/cto-soul.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow"
        },
        "webfetch": "allow"
      }
    },
    "pm": {
      "description": "Product manager focused on scope control, backlog discipline, and meeting synthesis.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/prompts/pm-soul.txt}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        },
        "webfetch": "allow"
      }
    },
    "developer": {
      "description": "Execution-focused builder that produces a runnable local workspace.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/prompts/developer-soul.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow"
        },
        "webfetch": "allow"
