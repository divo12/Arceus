# ─────────────────────────────────────────────────────────────────
# Arceus docker compose env template.
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
# ─────────────────────────────────────────────────────────────────

# REQUIRED — bearer token the API gates mutating routes on.
#   openssl rand -hex 32
ARCEUS_TOKEN=

# REQUIRED — Azure OpenAI for the agent runtime.
ARCEUS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
ARCEUS_AZURE_OPENAI_API_KEY=
ARCEUS_AZURE_OPENAI_RESOURCE_NAME=your-resource-name
ARCEUS_AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Optional — defaults are sensible.
ARCEUS_AZURE_OPENAI_API_VERSION=2024-10-21
ARCEUS_REQUIRE_AUTH=0
ARCEUS_PERSISTENCE_MODE=local
ARCEUS_MEETINGS_ENABLED=true

# Postgres credentials for the local pgvector container.
POSTGRES_USER=arceus
POSTGRES_PASSWORD=arceus
POSTGRES_DB=arceus

# Frontend → backend rewrite target (browser-side baseURL).
NEXT_PUBLIC_API_URL=http://localhost:4000

# OpenCode CLI version pinned into the API image.
OPENCODE_VERSION=1.3.17

# Optional: Supabase Storage for workspace bundle sync.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
