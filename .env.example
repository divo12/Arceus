# ============================================================
# ARCEUS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Required vars will crash the server on startup if missing.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000                                    # API port (default: 4000)
HOST=0.0.0.0                                 # Bind address (default: 0.0.0.0)

# ── Azure OpenAI (REQUIRED) ────────────────────────────────
ARCEUS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
ARCEUS_AZURE_OPENAI_API_KEY=your-azure-api-key
ARCEUS_AZURE_OPENAI_API_VERSION=2024-10-21
ARCEUS_AZURE_OPENAI_RESOURCE_NAME=your-resource-name

# Model deployments — set one fallback OR per-role overrides
ARCEUS_AZURE_OPENAI_DEPLOYMENT=gpt-4.1       # Fallback for all agents
# ARCEUS_AZURE_OPENAI_CEO_DEPLOYMENT=gpt-4.1  # Override for CEO
# ARCEUS_AZURE_OPENAI_WORKER_DEPLOYMENT=gpt-4.1-mini  # Override for workers

# ── OpenCode Agent Runtime ──────────────────────────────────
ARCEUS_OPENCODE_HOST=127.0.0.1               # OpenCode server host (default: 127.0.0.1)
ARCEUS_OPENCODE_PORT=4096                    # OpenCode server port (default: 4096)

# ── Supabase (Persistence — optional, in-memory without) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Storage buckets (defaults shown)
SUPABASE_STORAGE_BUCKET=arceus-workspaces
SUPABASE_ASSETS_BUCKET=arceus-assets

# ── Hippocampus Memory (uses Supabase DB by default) ───────
# Only set if using a DIFFERENT Postgres for hippocampus
# ARCEUS_HIPPOCAMPUS_POSTGRES_URL=postgresql://...
# ARCEUS_HIPPOCAMPUS_POSTGRES_SCHEMA=hippocampus
# ARCEUS_HIPPOCAMPUS_VECTOR_INDEX_TYPE=hnsw

# ── Workspace ───────────────────────────────────────────────
# ARCEUS_WORKSPACE_ROOT=/tmp/workspaces      # Default on Unix

# ── Orchestrator ────────────────────────────────────────────
# ARCEUS_DEMO_MODE=false                     # Enable frontend-only constraints
# ARCEUS_MEETINGS_ENABLED=true               # Set false to disable meeting scheduler

# ── Frontend (Vercel) ──────────────────────────────────────
# Set this in Vercel dashboard for the web app
# NEXT_PUBLIC_API_URL=https://your-api.railway.app
