# Paperclip server
HOST=127.0.0.1
PORT=3100
SERVE_UI=false

# Paperclip control-plane Postgres
DATABASE_URL=postgres://paperclip:paperclip@127.0.0.1:5432/paperclip

# Embedded Hippocampus runtime
PAPERCLIP_HIPPOCAMPUS_MODE=embedded
PAPERCLIP_HIPPOCAMPUS_PYTHON_BIN=/absolute/path/to/Arceus/backend/.venv/bin/python
PAPERCLIP_HIPPOCAMPUS_STARTUP_TIMEOUT_MS=15000
PAPERCLIP_HIPPOCAMPUS_REQUEST_TIMEOUT_MS=30000

# Hippocampus relational + vector storage (Postgres with pgvector installed)
# This may be the same Postgres cluster as DATABASE_URL, but the target DB must
# have `CREATE EXTENSION IF NOT EXISTS vector` available.
ARCEUS_HIPPOCAMPUS_POSTGRES_URL=postgres://hippocampus:hippocampus@127.0.0.1:5433/hippocampus
ARCEUS_HIPPOCAMPUS_POSTGRES_SCHEMA=hippocampus
ARCEUS_HIPPOCAMPUS_VECTOR_INDEX_TYPE=hnsw

# Hippocampus working memory (Redis)
ARCEUS_HIPPOCAMPUS_REDIS_URL=redis://127.0.0.1:6379/0

# Hippocampus graph memory (Neo4j)
ARCEUS_NEO4J_URI=bolt://127.0.0.1:7687
ARCEUS_NEO4J_USERNAME=neo4j
ARCEUS_NEO4J_PASSWORD=replace-me
ARCEUS_NEO4J_DATABASE=neo4j

# Hippocampus LLM calls (Azure OpenAI)
# Current runtime wiring uses `gpt-4.1` and `gpt-4.1-mini` directly as the
# Azure model/deployment names, so your Azure deployment names should match.
ARCEUS_AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
ARCEUS_AZURE_OPENAI_API_KEY=replace-me
ARCEUS_AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Optional Hippocampus debug logging
ARCEUS_DEBUG=true

# ────────────────────────────────────────────────────────────────
# Supabase Integration (optional, for hosted deployments)
# ────────────────────────────────────────────────────────────────

# Main Paperclip DB on Supabase (use pooled connection for the app)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.co:6543/postgres

# Hippocampus on Supabase — use DIRECT connection (port 5432) for DDL/pgvector
# ARCEUS_HIPPOCAMPUS_POSTGRES_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage provider
# PAPERCLIP_STORAGE_PROVIDER=supabase
# PAPERCLIP_STORAGE_SUPABASE_PROJECT_URL=https://[PROJECT-REF].supabase.co
# PAPERCLIP_STORAGE_SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key
# PAPERCLIP_STORAGE_SUPABASE_BUCKET=paperclip
