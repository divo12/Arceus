# ============================================================
# ARCEUS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Required vars will crash the server on startup if missing.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000                                    # API port (default: 4000)
HOST=0.0.0.0                                 # Bind address (default: 0.0.0.0)

# ── Azure OpenAI (REQUIRED) ────────────────────────────────
ARCEUS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
ARCEUS_AZURE_OPENAI_API_KEY=your-azure-api-key
ARCEUS_AZURE_OPENAI_API_VERSION=2024-10-21
ARCEUS_AZURE_OPENAI_RESOURCE_NAME=your-resource-name

# Model deployments — set one fallback OR per-role overrides.
# Employee beats (all roles) use CEO_DEPLOYMENT (gpt-5.2). Worker/memory
# deployments remain for auxiliary LLM traffic (meetings, hippocampus, etc.).
ARCEUS_AZURE_OPENAI_DEPLOYMENT=gpt-5.2       # Fallback for all agents
ARCEUS_AZURE_OPENAI_CEO_DEPLOYMENT=gpt-5.2   # All employee OpenCode beats
# ARCEUS_AZURE_OPENAI_WORKER_DEPLOYMENT=gpt-5.4-mini  # Aux / legacy worker pool

# ── OpenCode Agent Runtime ──────────────────────────────────
ARCEUS_OPENCODE_HOST=127.0.0.1               # OpenCode server host (default: 127.0.0.1)
ARCEUS_OPENCODE_PORT=4096                    # OpenCode server port (default: 4096)

# ── Supabase (Persistence — optional, in-memory without) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Storage buckets (defaults shown)
SUPABASE_STORAGE_BUCKET=arceus-workspaces
SUPABASE_ASSETS_BUCKET=arceus-assets

# ── Hippocampus Memory (uses Supabase DB by default) ───────
# Only set if using a DIFFERENT Postgres for hippocampus
# ARCEUS_HIPPOCAMPUS_POSTGRES_URL=postgresql://...
# ARCEUS_HIPPOCAMPUS_POSTGRES_SCHEMA=hippocampus
# ARCEUS_HIPPOCAMPUS_VECTOR_INDEX_TYPE=hnsw

# ── Workspace ───────────────────────────────────────────────
# ARCEUS_WORKSPACE_ROOT=/tmp/workspaces      # Default on Unix

# ── Orchestrator ────────────────────────────────────────────
# ARCEUS_DEMO_MODE=false                     # Enable frontend-only constraints
# ARCEUS_MEETINGS_ENABLED=true               # Set false to disable meeting scheduler

# ── Auth (Audit C4) ─────────────────────────────────────────
# Admin bearer token gating mutating /api/* routes. Required in
# production (≥16 chars). In dev, falls back to "arceus-dev-token"
# with a warning. Distinct from ARCEUS_INTERNAL_TOKEN, which gates
# the /api/internal/* MCP surface that agents call.
# ARCEUS_ADMIN_TOKEN=set-a-strong-random-token-at-least-16-chars

# Bearer token for the internal MCP surface (`/api/internal/*`).
# Falls back to ARCEUS_ADMIN_TOKEN (or ARCEUS_TOKEN) if unset.
# ARCEUS_INTERNAL_TOKEN=set-a-strong-random-token-at-least-16-chars

# Force the admin auth gate on/off regardless of NODE_ENV.
#   1 / true  → always require admin token on POST/PUT/PATCH/DELETE
#   0 / false → never require (escape hatch — DO NOT USE IN PRODUCTION
#               unless you have a trusted reverse-proxy doing auth)
#   unset     → on when NODE_ENV=production, off otherwise
# ARCEUS_REQUIRE_AUTH=1

# CORS allow-list (comma-separated). Replaces the legacy `origin: true`
# that echoed any caller's Origin. Required in production for browser
# clients. Use "*" to disable (server-to-server only deployments).
# Default in dev: localhost:3000 + localhost:4000.
# ARCEUS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# ── Public product URLs (*.arceus.sh) + Vercel full-stack ship ─
# Board-facing URL form (single DNS label — Railway wildcards can't match *.*):
#   https://<name>-<company_hash>.arceus.sh
# Product SPA + Hono API deploy to Vercel; AI gateway stays on Railway.
# ARCEUS_PREVIEW_PUBLIC_DOMAIN=arceus.sh
# ARCEUS_VERCEL_TOKEN=vercel_xxx          # deploy + domain + env scope
# ARCEUS_VERCEL_TEAM_ID=team_xxx          # optional
# ARCEUS_API_PUBLIC_ORIGIN=https://api.arceus.sh   # Railway API for /api/ai rewrites
# Turso (durable SQLite for product Hono on Vercel) — create org + group first:
# ARCEUS_TURSO_TOKEN=...                  # Platform API token
# ARCEUS_TURSO_ORG=your-org-slug
# ARCEUS_TURSO_GROUP=default
# Wildcard DNS: *.arceus.sh → Railway API (preview proxy) / Vercel (prod sites).
# Optional fixed override (disables per-company host pattern):
# ARCEUS_PREVIEW_PUBLIC_BASE_URL=

# ── Frontend (Vercel) ──────────────────────────────────────
# Set this in Vercel dashboard for the web app
# NEXT_PUBLIC_API_URL=https://your-api.railway.app
