{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./tsconfig.docs.json",
  "entryPoints": [
    "packages/contracts/src/index.ts",
    "packages/db/src/index.ts",
    "packages/hippocampus/src/index.ts",
    "packages/company-runtime/src/index.ts",
    "packages/task-engine/src/index.ts",
    "apps/api/src/agents/index.ts",
    "apps/api/src/config/index.ts",
    "apps/api/src/governance/index.ts",
    "apps/api/src/heartbeats/index.ts",
    "apps/api/src/infra/index.ts",
    "apps/api/src/meetings/index.ts",
    "apps/api/src/memory/index.ts",
    "apps/api/src/observability/index.ts",
    "apps/api/src/orchestration/index.ts",
    "apps/api/src/persistence/index.ts",
    "apps/api/src/prompts/index.ts",
    "apps/api/src/routes/index.ts",
    "apps/api/src/skills/index.ts",
    "apps/api/src/sprints/index.ts",
    "apps/api/src/tasks/index.ts",
    "apps/api/src/workspace/index.ts"
  ],
  "entryPointStrategy": "expand",
  "out": "docs/reference/api",
  "docsRoot": "docs",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "githubPages": false,
  "categorizeByGroup": true,
  "disableSources": true,
  "outputFileStrategy": "modules",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "propertyMembersFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "parametersFormat": "table",
  "indexFormat": "table",
  "expandObjects": false,
  "useCodeBlocks": false
}
