# Hippocampus API sidecar configuration
# Copy to .env and fill in real values

ARCEUS_DEBUG=true
ARCEUS_SQLITE_PATH=./hippocampus.db

# Azure OpenAI — required for LLM-driven extraction & reasoning.
# Leave empty to use noop backends (memories still work, just no auto-extraction).
ARCEUS_AZURE_OPENAI_ENDPOINT=
ARCEUS_AZURE_OPENAI_API_KEY=
ARCEUS_AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Model deployments (must match your Azure OpenAI deployment names)
ARCEUS_MODEL_CEO=gpt-5.1-chat
ARCEUS_MODEL_EMPLOYEE=gpt-5.1-chat
ARCEUS_MODEL_SPAWNED=gpt-5.1-chat

# Embedding model (sentence-transformers name, or "noop" for testing)
ARCEUS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph backend: "in_memory" (default) or "neo4j"
ARCEUS_GRAPH_BACKEND=in_memory
