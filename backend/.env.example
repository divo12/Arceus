# Arceus Backend Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://arceus:arceus@localhost:5432/arceus

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2025-03-01-preview
MODEL_CEO=gpt-5
MODEL_EMPLOYEE=gpt-4.1-mini
MODEL_SPAWNED=gpt-4.1-nano
MODEL_EMBEDDING=text-embedding-3-small

# Mem0 (self-hosted)
MEM0_URL=http://localhost:8080

# E2B
E2B_API_KEY=your-e2b-key-here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
